{% assign navigation = site.data.navigation[include.nav] %}

<nav class="nav__list">
  <ul>
    {% for nav in navigation %}
    <li>
        <a href="{{ nav.url | relative_url }}" class="nav__sub-title">
          {{ nav.title }}
        </a>

      {% if nav.children %}
        <ul>
          {% for child in nav.children %}
            <li>
              <a href="{{ child.url | relative_url }}">
                {{ child.title }}
              </a>
          {% endfor %}
        </ul>
      {% endif %}
    {% endfor %}
  </ul>
</nav>